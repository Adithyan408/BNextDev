<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BNext Dev | Domains</title>

  <!-- Tailwind -->
  <link rel="stylesheet" href="/tailwind.min.css" />
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-blue-100">

<!-- ================= HEADER ================= -->
<header class="bg-white shadow-sm">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-4 flex items-center justify-between">
    <div class="flex items-center gap-2 text-blue-600 font-bold text-lg">
      <span class="text-xl">&lt;/&gt;</span>
      <span>BNext Dev</span>
    </div>

    <!-- Profile Avatar (placeholder) -->
    <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
      👤
    </div>
  </div>
</header>

<!-- ================= MAIN ================= -->
<main class="max-w-7xl mx-auto px-6 md:px-12 py-14">

  <!-- Title -->
  <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
    Choose Your Domain
  </h1>
  <p class="text-gray-600 mt-2 max-w-2xl">
    Select a tech stack to begin your learning journey with community-curated topics
  </p>

  <!-- ================= DOMAINS GRID ================= -->
  <section class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

    <!-- MERN -->
    <a
      href="/domains/mern"
      class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition
             border border-gray-100 hover:border-blue-200"
    >
      <div class="flex items-start justify-between">
        <div class="w-14 h-14 rounded-xl bg-green-100 flex items-center justify-center text-green-600 text-xl">
          &lt;/&gt;
        </div>
        <div class="text-right">
          <h3 class="text-2xl font-bold text-gray-900">48</h3>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Topics</p>
        </div>
      </div>

      <h2 class="mt-6 text-xl font-semibold text-gray-900">
        MERN Stack
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        MongoDB, Express.js, React, Node.js
      </p>
    </a>

    <!-- Flutter -->
    <a
      href="/domains/flutter"
      class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition
             border border-gray-100 hover:border-blue-200"
    >
      <div class="flex items-start justify-between">
        <div class="w-14 h-14 rounded-xl bg-blue-100 flex items-center justify-center text-blue-600 text-xl">
          📱
        </div>
        <div class="text-right">
          <h3 class="text-2xl font-bold text-gray-900">36</h3>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Topics</p>
        </div>
      </div>

      <h2 class="mt-6 text-xl font-semibold text-gray-900">
        Flutter
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Cross-platform mobile development
      </p>
    </a>

    <!-- Django -->
    <a
      href="/domains/django"
      class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition
             border border-gray-100 hover:border-blue-200"
    >
      <div class="flex items-start justify-between">
        <div class="w-14 h-14 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600 text-xl">
          🌍
        </div>
        <div class="text-right">
          <h3 class="text-2xl font-bold text-gray-900">42</h3>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Topics</p>
        </div>
      </div>

      <h2 class="mt-6 text-xl font-semibold text-gray-900">
        Django
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Python web framework
      </p>
    </a>

  </section>
</main>

</body>
</html>
