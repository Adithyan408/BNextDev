<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BNext Dev | Onboarding</title>

  <!-- Tailwind -->
  <link rel="stylesheet" href="/tailwind.min.css" />
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-blue-100 flex flex-col">

<!-- ================= NAVBAR ================= -->
<nav class="w-full flex items-center justify-between px-6 md:px-16 py-6">
  <div class="text-blue-700 text-2xl font-bold tracking-wide">
    BNext Dev
  </div>

  <div class="hidden md:flex space-x-10 text-sm font-medium text-blue-600">
    <a href="/" class="hover:text-blue-800 transition">Home</a>
    <a href="/about" class="hover:text-blue-800 transition">About us</a>
    <a href="/contact" class="hover:text-blue-800 transition">Contact us</a>
  </div>

  <button id="menu-btn" class="md:hidden">
    <svg class="w-7 h-7 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</nav>

<!-- ================= MOBILE MENU ================= -->
<div id="mobile-menu" class="fixed inset-0 z-40 hidden">
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative bg-white pt-28 pb-16 shadow-2xl">
    <div class="flex flex-col items-center space-y-10 text-xl font-medium">
      <a href="/" class="text-blue-600">Home</a>
      <a href="/about" class="text-blue-600">About us</a>
      <a href="/contact" class="text-blue-600">Contact us</a>
    </div>
  </div>
</div>

<!-- ================= ONBOARDING CARD ================= -->
<main class="flex-1 flex items-center justify-center px-4">

  <div class="bg-white w-full max-w-md rounded-2xl shadow-xl px-8 py-10 text-center">

    <!-- Logo -->
    <div class="flex items-center justify-center gap-2 text-blue-600 font-bold text-lg mb-4">
      <span class="text-xl">&lt;/&gt;</span>
      <span>BNext Dev</span>
    </div>

    <!-- Heading -->
    <h1 class="text-xl font-semibold text-gray-900">
      Complete Your Profile
    </h1>
    <p class="text-sm text-gray-500 mt-1 mb-8">
      Tell us a bit about yourself to get started
    </p>

    <!-- Form -->
    <form action="/profile" method="POST" class="space-y-5 text-left"  id="onboardingForm">

      <!-- Full Name -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          name="name"
          placeholder="John Doe"
          required
          class="mt-1 w-full rounded-lg border border-gray-200 px-4 py-2.5
                 text-sm outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>

      <!-- Phone -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          Phone Number <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          name="phone"
          placeholder="+1 (555) 000-0000"
          required
          class="mt-1 w-full rounded-lg border border-gray-200 px-4 py-2.5
                 text-sm outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>

      <!-- Education -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          Education Qualification <span class="text-red-500">*</span>
        </label>
        <select
          name="education"
          required
          class="mt-1 w-full rounded-lg border border-gray-200 px-4 py-2.5
                 text-sm outline-none focus:ring-2 focus:ring-blue-400 bg-white"
        >
          <option value="" disabled selected>Select your qualification</option>
          <option value="high_school">High School</option>
          <option value="diploma">Diploma</option>
          <option value="undergraduate">Undergraduate</option>
          <option value="postgraduate">Postgraduate</option>
          <option value="self_taught">Self Taught</option>
        </select>
      </div>
      <p id="formError" class="text-sm text-red-500 hidden"></p>

      <!-- Submit -->
      <button
        type="submit"
        class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white
               font-medium py-2.5 rounded-lg transition shadow-md"
      >
        Continue to Domains
      </button>

    </form>

  </div>

</main>

<!-- ================= SCRIPT ================= -->
<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  menuBtn.addEventListener("click", () => {
    mobileMenu.classList.toggle("hidden");
  });

  mobileMenu.addEventListener("click", (e) => {
    if (e.target === mobileMenu || e.target.tagName === "A") {
      mobileMenu.classList.add("hidden");
    }
  });

   const form = document.getElementById("onboardingForm");
  const errorBox = document.getElementById("formError");

  form.addEventListener("submit", function (e) {
    errorBox.classList.add("hidden");
    errorBox.textContent = "";

    const name = form.name.value.trim();
    const phone = form.phone.value.trim();
    const education = form.education.value;

    // Name validation
    if (name.length < 3) {
      showError("Please enter a valid full name");
      e.preventDefault();
      return;
    }

    // Phone validation (basic international format)
    const phoneRegex = /^[+]?[\d\s()-]{8,15}$/;
    if (!phoneRegex.test(phone)) {
      showError("Please enter a valid phone number");
      e.preventDefault();
      return;
    }

    // Education validation
    if (!education) {
      showError("Please select your education qualification");
      e.preventDefault();
      return;
    }
  });

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }
</script>

</body>
</html>
