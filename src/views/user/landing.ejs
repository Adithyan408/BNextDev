<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BNext Dev</title>

  <!-- Tailwind -->
  <link rel="stylesheet" href="/tailwind.min.css" />
</head>

<body class="min-h-screen flex flex-col bg-gradient-to-br from-blue-50 via-white to-blue-100">

<!-- ================= NAVBAR ================= -->
<nav class="w-full flex items-center justify-between px-6 md:px-16 py-6 bg-transparent z-50">
  <h1 class="text-2xl font-bold text-blue-700 tracking-wide">BNext Dev</h1>

  <div class="hidden md:flex space-x-10 text-sm font-medium text-blue-600">
    <a href="/" class="hover:text-blue-800">Home</a>
    <a href="/about" class="hover:text-blue-800">About us</a>
    <a href="/contact" class="hover:text-blue-800">Contact us</a>
  </div>

  <button id="menu-btn" class="md:hidden">
    <svg class="w-7 h-7 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</nav>

<!-- ================= MOBILE MENU ================= -->
<div id="mobile-menu" class="fixed inset-0 z-40 hidden">
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative bg-white pt-28 pb-16 shadow-2xl">
    <div class="flex flex-col items-center space-y-10 text-xl font-medium">
      <a href="/" class="text-blue-600">Home</a>
      <a href="/about" class="text-blue-600">About us</a>
      <a href="/contact" class="text-blue-600">Contact us</a>
    </div>
  </div>
</div>

<!-- ================= HERO ================= -->
<section class="flex flex-col items-center justify-center text-center px-4 pt-28 pb-36">

  <!-- Badge -->
  <span class="inline-flex items-center gap-2 bg-blue-100 text-blue-600 px-4 py-1 rounded-full text-sm font-medium">
    👥 Community-Powered Learning Platform
  </span>

  <!-- Heading -->
  <h1 class="mt-8 text-4xl md:text-6xl font-extrabold text-gray-900">
    Master Tech Stacks
  </h1>
  <h2 class="mt-2 text-4xl md:text-6xl font-extrabold text-blue-600">
    Together
  </h2>

  <!-- Description -->
  <p class="mt-6 max-w-2xl text-gray-600 text-sm md:text-base leading-relaxed">
    Join a community of learners and contributors. Share topics, suggest questions,
    and help others master MERN, Flutter, Django, and more through collaborative learning.
  </p>

  <!-- CTA -->
  <a href="/domains"
     class="mt-8 inline-block bg-blue-600 text-white px-8 py-3 rounded-full font-medium
            hover:bg-blue-700 transition shadow-lg">
    Get Started
  </a>

</section>

<!-- ================= STATS BAR ================= -->
<section class="w-full bg-gradient-to-r from-blue-900 to-blue-600 text-white py-6">
  <div class="max-w-5xl mx-auto grid grid-cols-3 text-center">
    <div>
      <h3 class="text-2xl font-bold">0+</h3>
      <p class="text-sm opacity-90">Tech Stacks</p>
    </div>
    <div>
      <h3 class="text-2xl font-bold">0+</h3>
      <p class="text-sm opacity-90">Topics</p>
    </div>
    <div>
      <h3 class="text-2xl font-bold">100%</h3>
      <p class="text-sm opacity-90">Self-paced</p>
    </div>
  </div>
</section>

<!-- ================= FEATURES ================= -->
<section class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-8 px-4 mt-20 mb-32">

  <div class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition text-center">
    <div class="w-14 h-14 mx-auto bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
      📈
    </div>
    <h3 class="font-semibold text-lg">Community Driven</h3>
    <p class="text-gray-600 text-sm mt-2">
      Learn from topics and questions shared by developers who’ve already mastered the stack.
    </p>
  </div>

  <div class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition text-center">
    <div class="w-14 h-14 mx-auto bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
      🧩
    </div>
    <h3 class="font-semibold text-lg">Structured Topics</h3>
    <p class="text-gray-600 text-sm mt-2">
      Follow organized learning paths with topics ranked by complexity and importance.
    </p>
  </div>

  <div class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition text-center">
    <div class="w-14 h-14 mx-auto bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
      💻
    </div>
    <h3 class="font-semibold text-lg">Multiple Stacks</h3>
    <p class="text-gray-600 text-sm mt-2">
      Choose from MERN, Flutter, Django, and more modern stacks.
    </p>
  </div>

  <div class="bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition text-center">
    <div class="w-14 h-14 mx-auto bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
      ⏱️
    </div>
    <h3 class="font-semibold text-lg">Self-Paced Learning</h3>
    <p class="text-gray-600 text-sm mt-2">
      Research independently and build deep understanding at your own pace.
    </p>
  </div>

</section>

<!-- ================= FOOTER ================= -->
<footer class="text-center text-gray-500 py-6 text-sm">
  © 2025 BNext Dev. All rights reserved.
</footer>

<!-- ================= SCRIPT ================= -->
<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  menuBtn.addEventListener("click", () => {
    mobileMenu.classList.toggle("hidden");
  });

  mobileMenu.addEventListener("click", (e) => {
    if (e.target === mobileMenu || e.target.tagName === "A") {
      mobileMenu.classList.add("hidden");
    }
  });
</script>

</body>
</html>
